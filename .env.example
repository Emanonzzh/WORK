# ================== 环境变量示例 ==================
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，永不入库）
# 或者：不用 .env，直接设置系统环境变量（Windows: setx / PowerShell $env:）

DASHSCOPE_API_KEY=your_dashscopeApiKey_here

# 模型服务地址（可选，不填则用代码里的默认值 = 下面的旧共享域名）
# 阿里云公告：旧共享域名 dashscope.aliyuncs.com 于 2026-09-30 起进入维护状态（不再迭代新特性，
# 现有服务不受影响），建议迁到百炼业务空间专属域名，格式为：
#   https://{workspaceId}.{region}.maas.aliyuncs.com/compatible-mode/v1
# workspaceId 在百炼控制台「业务空间」里查。迁移只需改这一行，代码不用动。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
